<!DOCTYPE html>
<html lang="en">
    <head>
        {% set seo_title %}{% block title %}Clichmont | Data Center Infrastructure{% endblock %}{% endset %}
        {% set seo_description %}{% block meta_description %}Clichmont designs and operates high-performance data center infrastructure across Europe for compute-intensive workloads.{% endblock %}{% endset %}
        {% set seo_canonical %}{% block meta_canonical %}{{ app.request ? app.request.uri : absolute_url(path('app_home')) }}{% endblock %}{% endset %}
        {% set seo_image %}{% block meta_image %}{{ absolute_url(asset('images/clichmont-logo-v1.webp')) }}{% endblock %}{% endset %}
        {% set seo_robots %}{% block meta_robots %}index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1{% endblock %}{% endset %}

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ seo_title|striptags|trim }}</title>
        <meta name="description" content="{{ seo_description|striptags|trim }}">
        <meta name="robots" content="{{ seo_robots|striptags|trim }}">
        <meta name="author" content="Clichmont">
        <meta name="theme-color" content="#050816">
        <link rel="canonical" href="{{ seo_canonical|striptags|trim }}">
        <link rel="icon" type="image/webp" href="{{ asset('images/clichmont-symbol-transparent-v2.webp') }}">
        <link rel="apple-touch-icon" href="{{ asset('images/clichmont-symbol-transparent-v2.webp') }}">

        <meta property="og:locale" content="en_GB">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Clichmont">
        <meta property="og:title" content="{{ seo_title|striptags|trim }}">
        <meta property="og:description" content="{{ seo_description|striptags|trim }}">
        <meta property="og:url" content="{{ seo_canonical|striptags|trim }}">
        <meta property="og:image" content="{{ seo_image|striptags|trim }}">
        <meta property="og:image:alt" content="Clichmont compute-ready data center infrastructure">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ seo_title|striptags|trim }}">
        <meta name="twitter:description" content="{{ seo_description|striptags|trim }}">
        <meta name="twitter:image" content="{{ seo_image|striptags|trim }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
