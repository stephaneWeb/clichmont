{% extends 'base.html.twig' %}

{% block title %}Clichmont | Compute-Ready Data Centers and GPU Infrastructure{% endblock %}
{% block meta_description %}Clichmont designs and operates compute-ready data centers, GPU infrastructure, and private cloud environments across Europe for AI, rendering, HPC, and enterprise workloads.{% endblock %}

{% block body %}
    <div class="page-shell">
        <header class="site-header">
            <nav class="navbar navbar-expand-lg py-3">
                <div class="container">
                    <a class="brand-mark navbar-brand m-0" href="{{ path('app_home') }}">
                        <img class="brand-logo" src="{{ asset('images/clichmont-logo-transparent-ui-256-v1.webp') }}" alt="Clichmont" width="256" height="256" decoding="async" fetchpriority="low">
                    </a>

                    <button class="navbar-toggler border-0 shadow-none text-white" type="button" data-nav-toggle aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav" data-nav-collapse>
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                            <li class="nav-item"><a class="nav-link" href="#platform">Ecosystem</a></li>
                            <li class="nav-item"><a class="nav-link" href="#infrastructure">Infrastructure</a></li>
                            <li class="nav-item"><a class="nav-link" href="#locations">Locations</a></li>
                            <li class="nav-item"><a class="nav-link" href="#footer">Contact</a></li>
                            <li class="nav-item nav-item--ico ms-lg-2 mt-3 mt-lg-0">
                                <div class="ico-soon ico-soon--nav" data-ico-soon>
                                    <button class="btn btn-primary btn-ico-soon" type="button" data-ico-toggle aria-expanded="false" aria-controls="ico-panel-nav">Join ICO Soon</button>
                                    <div class="ico-soon__panel" id="ico-panel-nav" data-ico-panel hidden>
                                        <strong class="ico-soon__title">ICO Update</strong>
                                        <p class="ico-soon__text">We are also creating the Clichmont AI token ($CLAI), which will be at the heart of the Clichmont ecosystem. The $CLAI ICO is scheduled for September 2026!</p>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main>
            <section class="hero hero-sequence" data-hero-sequence>
                <div class="hero-stage">
                    <div class="hero-shell">
                        <div class="hero-frame">
                            <div class="hero-frame-glow" aria-hidden="true"></div>

                            <div class="hero-kicker" aria-hidden="true">
                                <span>Compute power</span>
                                <span>at scale</span>
                            </div>

                            <div class="hero-symbol" aria-label="Clichmont hero logo">
                                <img class="hero-symbol-static" src="{{ asset('images/clichmont-logo-transparent-hero-mobile-512-v1.webp') }}" alt="Clichmont" width="512" height="512" loading="eager" fetchpriority="high" decoding="async">
                            </div>

                            <div class="hero-bottom-copy" data-hero-bottom>
                                <div class="hero-bottom-block">
                                    <h2>Compute power, shaped for enterprise.</h2>
                                    <p>
                                        Clichmont designs and operates GPU-ready environments for private cloud, AI workloads, rendering, and mission-critical compute operations.
                                    </p>
                                </div>
                                <div class="hero-bottom-block">
                                    <p>
                                        High-density rooms, resilient power, secure deployment, and premium operational support are presented as one coherent infrastructure story.
                                    </p>
                                    <p>We are also creating the Clichmont AI token ($CLAI), which will be at the heart of the Clichmont ecosystem. The $CLAI ICO is scheduled for September 2026!</p>
                                    <div class="ico-soon mt-3" data-ico-soon>
                                        <button class="btn btn-light rounded-pill px-4 btn-ico-soon" type="button" data-ico-toggle aria-expanded="false" aria-controls="ico-panel-hero">Join ICO Soon</button>
                                        <div class="ico-soon__panel" id="ico-panel-hero" data-ico-panel hidden>
                                            <strong class="ico-soon__title">ICO Update</strong>
                                            <p class="ico-soon__text">We are also creating the Clichmont AI token ($CLAI), which will be at the heart of the Clichmont ecosystem. The $CLAI ICO is scheduled for September 2026!</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section id="platform" class="white-section platform-section" data-platform-reveal>
                <div class="container">
                    <div class="row g-4 align-items-start">
                        <div class="col-lg-4">
                            <div data-platform-intro>
                                <span class="section-label">Ecosystem Overview</span>
                                <h2 class="display-6 fw-semibold mt-4 mb-3">An ecosystem designed for scalable AI infrastructure.</h2>
                                <p class="text-muted-contrast mb-4">
                                    Clichmont combines compute capacity, resilient facilities, and operational support into one clear platform for AI training, inference, rendering, and enterprise-grade deployments.
                                </p>
                            </div>
                            <div class="ico-soon" data-ico-soon>
                                <button class="btn rounded-pill px-4 btn-platform-pulse btn-ico-soon" type="button" data-platform-cta data-ico-toggle aria-expanded="false" aria-controls="ico-panel-platform">Join ICO Soon</button>
                                <div class="ico-soon__panel" id="ico-panel-platform" data-ico-panel hidden>
                                    <strong class="ico-soon__title">ICO Update</strong>
                                    <p class="ico-soon__text">We are also creating the Clichmont AI token ($CLAI), which will be at the heart of the Clichmont ecosystem. The $CLAI ICO is scheduled for September 2026!</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-8">
                            <div class="row g-4" data-platform-cards>
                                <div class="col-md-6">
                                    <article class="white-panel white-panel--reveal" data-reveal-card style="--card-index: 0;">
                                        <div class="icon-chip">01</div>
                                        <h3 class="h5">Compute Architecture</h3>
                                        <p class="mb-0">GPU clusters, bare-metal nodes, virtualization layers, and private deployments tuned to workload intensity.</p>
                                    </article>
                                </div>
                                <div class="col-md-6">
                                    <article class="white-panel white-panel--reveal" data-reveal-card style="--card-index: 1;">
                                        <div class="icon-chip">02</div>
                                        <h3 class="h5">Scalable Facilities</h3>
                                        <p class="mb-0">Modular expansion logic for power, rack density, and storage so the site story supports growth.</p>
                                    </article>
                                </div>
                                <div class="col-md-6">
                                    <article class="white-panel white-panel--reveal" data-reveal-card style="--card-index: 2;">
                                        <div class="icon-chip">03</div>
                                        <h3 class="h5">Security Layers</h3>
                                        <p class="mb-0">Physical security, access control, network segmentation, and clear governance messaging.</p>
                                    </article>
                                </div>
                                <div class="col-md-6">
                                    <article class="white-panel white-panel--reveal" data-reveal-card style="--card-index: 3;">
                                        <div class="icon-chip">04</div>
                                        <h3 class="h5">Operational Support</h3>
                                        <p class="mb-0">Concierge onboarding, deployment guidance, and monitoring-first operational framing.</p>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="platform-showcase" data-reveal-card style="--card-index: 4;">
                        <article class="platform-showcase__story">
                            <span class="section-label">Target Workloads</span>
                            <h3>Built for high-value AI, cloud, and enterprise compute workloads.</h3>
                            <p>
                                Clichmont supports organizations that need performance, resilience, and operational clarity
                                across GPU clusters, private cloud, research environments, and mission-critical deployments.
                            </p>
                            <div class="platform-showcase__metrics">
                                <span>Enterprise GPU Clusters</span>
                                <span>Private Cloud Rollouts</span>
                                <span>Mission-Critical AI Capacity</span>
                            </div>
                        </article>

                        <div class="platform-showcase__industries">
                            {% for item in platformIndustryTiles %}
                                <article class="platform-industry-chip">
                                    <span class="platform-industry-chip__icon" aria-hidden="true">
                                        {% if item.icon == 'ai' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="3.1"></circle>
                                                <path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6.4 6.4l1.6 1.6M16 16l1.6 1.6M17.6 6.4L16 8M8 16l-1.6 1.6"></path>
                                                <path d="M7.6 10.2 9.6 9M14.4 15 16.4 13.8M14.4 9 16.4 10.2M7.6 13.8 9.6 15"></path>
                                            </svg>
                                        {% elseif item.icon == 'mesh' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="6.2" r="1.8"></circle>
                                                <circle cx="7.3" cy="9" r="1.8"></circle>
                                                <circle cx="16.7" cy="9" r="1.8"></circle>
                                                <circle cx="7.3" cy="15" r="1.8"></circle>
                                                <circle cx="16.7" cy="15" r="1.8"></circle>
                                                <circle cx="12" cy="17.8" r="1.8"></circle>
                                                <path d="M10.4 7.2 8.8 8.1M13.6 7.2l1.6.9M7.3 10.8v2.4M16.7 10.8v2.4M8.8 15.9l1.6.9M15.2 15.9l-1.6.9M9.1 9.8h5.8M9.1 14.2h5.8"></path>
                                            </svg>
                                        {% elseif item.icon == 'research' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M8 4h8"></path>
                                                <path d="M10 4v4l-4.6 7.6A2 2 0 0 0 7.1 19h9.8a2 2 0 0 0 1.7-3.4L14 8V4"></path>
                                                <path d="M9 13c1 .7 2 .7 3 0s2-.7 3 0"></path>
                                            </svg>
                                        {% elseif item.icon == 'bio' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M8 4.5c2.1 0 3.8 1.7 3.8 3.8v7.4c0 2.1-1.7 3.8-3.8 3.8S4.2 17.8 4.2 15.7V8.3C4.2 6.2 5.9 4.5 8 4.5z"></path>
                                                <path d="M16 4.5c2.1 0 3.8 1.7 3.8 3.8v7.4c0 2.1-1.7 3.8-3.8 3.8s-3.8-1.7-3.8-3.8V8.3c0-2.1 1.7-3.8 3.8-3.8z"></path>
                                                <path d="M8 7h8M8 12h8M8 17h8"></path>
                                            </svg>
                                        {% elseif item.icon == 'finance' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M4 20h16"></path>
                                                <path d="M6 20V10M12 20V10M18 20V10"></path>
                                                <path d="M3.5 10h17L12 4 3.5 10z"></path>
                                            </svg>
                                        {% elseif item.icon == 'render' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="6.5"></circle>
                                                <circle cx="12" cy="12" r="2.1"></circle>
                                                <path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4"></path>
                                            </svg>
                                        {% elseif item.icon == 'engineering' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14.7 6.1a3.2 3.2 0 0 0-4.3 4.3l-5.9 5.9a1.5 1.5 0 1 0 2.1 2.1l5.9-5.9a3.2 3.2 0 0 0 4.3-4.3l-2.1 2.1-2.2-2.2 2.2-2.1z"></path>
                                            </svg>
                                        {% elseif item.icon == 'hpc' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="3"></circle>
                                                <path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7"></path>
                                                <path d="M9.8 9.8 8.3 8.3M14.2 14.2l1.5 1.5M14.2 9.8l1.5-1.5M9.8 14.2l-1.5 1.5"></path>
                                            </svg>
                                        {% endif %}
                                    </span>
                                    <h4>{{ item.title }}</h4>
                                </article>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="platform-activity mt-5 pt-lg-4">
                        <div class="platform-activity__panel" data-reveal-card style="--card-index: 5;">
                            <div class="platform-activity__grid">
                                {% for item in platformActivityCards %}
                                    <article class="platform-activity-card" data-reveal-card style="--card-index: {{ loop.index0 + 6 }};">
                                        <span class="platform-activity-card__icon" aria-hidden="true">
                                            {% if item.icon == 'servers' %}
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="4" y="4" width="16" height="6" rx="2"></rect>
                                                    <rect x="4" y="14" width="16" height="6" rx="2"></rect>
                                                    <path d="M8 7h.01M8 17h.01M12 7h5M12 17h5"></path>
                                                </svg>
                                            {% elseif item.icon == 'cloud' %}
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M7 18a4 4 0 0 1-.3-8A5.5 5.5 0 0 1 17 8.5a3.5 3.5 0 1 1 .5 7H7z"></path>
                                                </svg>
                                            {% elseif item.icon == 'shield' %}
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 3l7 3.2V11c0 4.6-2.8 8.9-7 10-4.2-1.1-7-5.4-7-10V6.2L12 3z"></path>
                                                    <rect x="9.3" y="10.2" width="5.4" height="4.9" rx="1"></rect>
                                                    <path d="M10.4 10.2V9a1.6 1.6 0 0 1 3.2 0v1.2"></path>
                                                </svg>
                                            {% elseif item.icon == 'support' %}
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M4 13a8 8 0 0 1 16 0"></path>
                                                    <rect x="3" y="12" width="4" height="7" rx="2"></rect>
                                                    <rect x="17" y="12" width="4" height="7" rx="2"></rect>
                                                    <path d="M12 20h3"></path>
                                                </svg>
                                            {% endif %}
                                        </span>
                                        <h4>{{ item.title }}</h4>
                                        <p class="mb-0">{{ item.description }}</p>
                                    </article>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="platform-activity__copy platform-activity__copy--panel" data-reveal-card style="--card-index: 10;">
                            <span class="section-label">Our Activity</span>
                            <h3 class="platform-activity__title">Compute Power Production and GPU Infrastructure Services</h3>
                            <p class="text-muted-contrast mb-4">
                                Clichmont produces and commercializes high-performance computing power for artificial intelligence,
                                machine learning, 3D rendering, scientific computing, and GPU-intensive applications.
                            </p>
                            <p class="text-muted-contrast mb-0">
                                We deploy, operate, and optimize enterprise GPU clusters, providing secure, scalable, and on-demand
                                compute capacity for organizations worldwide.
                            </p>
                        </div>
                    </div>

                </div>
            </section>

            <section id="infrastructure" class="dark-section infrastructure-section">
                <div class="container">
                    <div class="infrastructure-layout">
                        <div class="infrastructure-copy">
                            <span class="section-label">Our Infrastructure</span>
                            <h2 class="display-6 fw-semibold mt-4 mb-3">Built for Maximum Performance</h2>
                            <p class="muted-copy mb-4">
                                Our GPU infrastructure is purpose-built for AI, machine learning, rendering, and high-performance computing,
                                with premium storage, optimized software stacks, and operations-first resilience.
                            </p>

                            <div class="ico-soon" data-ico-soon>
                                <button class="btn btn-primary btn-ico-soon" type="button" data-ico-toggle aria-expanded="false" aria-controls="ico-panel-infra">Join ICO Soon</button>
                                <div class="ico-soon__panel" id="ico-panel-infra" data-ico-panel hidden>
                                    <strong class="ico-soon__title">ICO Update</strong>
                                    <p class="ico-soon__text">We are also creating the Clichmont AI token ($CLAI), which will be at the heart of the Clichmont ecosystem. The $CLAI ICO is scheduled for September 2026!</p>
                                </div>
                            </div>
                        </div>

                        <div class="infrastructure-orbit" aria-label="Infrastructure capabilities">
                            <div class="infrastructure-core">
                                <span class="infrastructure-core__eyebrow">Compute Mesh</span>
                                <strong>24/7</strong>
                                <p class="mb-0">AI compute, storage, cloud, and observability synchronized in one resilient ecosystem.</p>
                            </div>

                            <div class="infrastructure-orbit-track">
                                {% for item in infrastructureNodes %}
                                    <article class="infrastructure-node" style="--angle: {{ item.angle }}deg; --delay: {{ item.delay }};">
                                        <div class="infrastructure-node__body">
                                            <span class="infrastructure-node__icon" aria-hidden="true">
                                                {% if item.icon == 'gpu' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="3" y="6" width="18" height="12" rx="2"></rect>
                                                        <circle cx="9" cy="12" r="2.3"></circle>
                                                        <circle cx="15" cy="12" r="2.3"></circle>
                                                        <path d="M6 4v2M10 4v2M14 4v2M18 4v2M6 18v2M10 18v2M14 18v2M18 18v2"></path>
                                                    </svg>
                                                {% elseif item.icon == 'server' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="5" y="4" width="14" height="5" rx="1.5"></rect>
                                                        <rect x="5" y="10" width="14" height="5" rx="1.5"></rect>
                                                        <rect x="5" y="16" width="14" height="4" rx="1.5"></rect>
                                                        <path d="M8 6.5h.01M8 12.5h.01M8 18h.01M12 6.5h4M12 12.5h4M12 18h4"></path>
                                                    </svg>
                                                {% elseif item.icon == 'brain' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M9 4.5a3 3 0 0 0-3 3v.4A2.6 2.6 0 0 0 4 10.4c0 1 .58 1.87 1.42 2.3A3.2 3.2 0 0 0 8.5 17H10"></path>
                                                        <path d="M15 4.5a3 3 0 0 1 3 3v.4a2.6 2.6 0 0 1 2 2.5c0 1-.58 1.87-1.42 2.3A3.2 3.2 0 0 1 15.5 17H14"></path>
                                                        <path d="M12 4v16M9.5 8.5H12M12 12h3.5M8.5 15.5H12"></path>
                                                    </svg>
                                                {% elseif item.icon == 'inference' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="6.5"></circle>
                                                        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"></path>
                                                        <circle cx="12" cy="12" r="1.7"></circle>
                                                    </svg>
                                                {% elseif item.icon == 'network' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M10 3L5 12h5l-1 9 10-13h-5l2-5z"></path>
                                                    </svg>
                                                {% elseif item.icon == 'storage' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <ellipse cx="12" cy="6" rx="6.5" ry="2.5"></ellipse>
                                                        <path d="M5.5 6v12c0 1.38 2.9 2.5 6.5 2.5s6.5-1.12 6.5-2.5V6"></path>
                                                        <path d="M5.5 12c0 1.38 2.9 2.5 6.5 2.5s6.5-1.12 6.5-2.5"></path>
                                                    </svg>
                                                {% elseif item.icon == 'cloud' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M7 18a4 4 0 1 1 .8-7.92A5.5 5.5 0 0 1 18 11a3.5 3.5 0 1 1-.5 7H7z"></path>
                                                    </svg>
                                                {% elseif item.icon == 'monitoring' %}
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="4" y="5" width="16" height="11" rx="2"></rect>
                                                        <path d="M8 20h8M12 16v4M7.5 12l2.5-3 2.5 2 3-4"></path>
                                                    </svg>
                                                {% endif %}
                                            </span>
                                            <h3>{{ item.title }}</h3>
                                            <p class="mb-0">{{ item.description }}</p>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section id="locations" class="dark-section pt-0">
                <div class="container">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
                        <div>
                            <span class="section-label">Locations</span>
                            <h2 class="display-6 fw-semibold mt-4 mb-2">Our Current and Upcoming AI Compute Sites.</h2>
                        </div>
                    </div>

                    <div class="site-grid">
                        {% for site in siteLocations %}
                            <article
                                class="location-card"
                                style="
                                    --location-gradient: {{ site.gradient }};
                                    --location-image-position: {{ site.imagePosition|default('center center') }};
                                    --location-image-filter: {{ site.imageFilter|default('none') }};
                                "
                                data-location-photo
                            >
                                <div class="location-card__media">
                                    <img class="location-card__photo" src="{{ asset(site.image) }}" alt="{{ site.title }}" width="{{ site.imageWidth|default(1600) }}" height="{{ site.imageHeight|default(900) }}" loading="lazy" decoding="async">
                                    <img class="location-card__logo" src="{{ asset('images/clichmont-logo-transparent-ui-216-v1.webp') }}" alt="" aria-hidden="true" width="216" height="216" loading="lazy" decoding="async">
                                </div>
                                <div class="location-card__content">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <span class="site-pill">{{ site.label }}</span>
                                        <span class="site-phase">{{ site.timeline }}</span>
                                    </div>
                                    <h3 class="h3 mt-4 mb-3">{{ site.title }}</h3>
